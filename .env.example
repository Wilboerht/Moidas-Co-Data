# DataFlow API 配置（复制本文件为 .env 后填写）
# Host 在 dataflow 后台面板上查看（与后台 host 一致），需带协议，例如 https://api.example.com
DATAFLOW_HOST=

# 后台获取的 token，Authorization 头格式为 "Token <你的token>"
DATAFLOW_TOKEN=

# 可选：只允许请求这些服务商域名（逗号分隔，防止 token 被重定向带走）
DATAFLOW_ALLOWED_HOSTS=dataflowserver.org

# Rnote 备用服务商（只支持小红书）；API Key 在 https://rnote.dev 注册后台创建
RNOTE_HOST=https://rnote.dev
RNOTE_API_KEY=
RNOTE_ALLOWED_HOSTS=rnote.dev

# 其他小红书/抖音数据 API（按需配置，不配置则不启用）
EVERYINFRA_API_KEY=
TIKHUB_API_KEY=
JUSTONEAPI_TOKEN=
SOCIALDATAX_API_KEY=
REDFOX_API_KEY=
EVERYINFRA_ALLOWED_HOSTS=api.everyinfra.com
TIKHUB_ALLOWED_HOSTS=api.tikhub.io
JUSTONEAPI_ALLOWED_HOSTS=api.justoneapi.com
SOCIALDATAX_ALLOWED_HOSTS=mcp.socialdatax.com
REDFOX_ALLOWED_HOSTS=redfox.hk

# 费用换算：1 token = 0.001 元；1 USD 约等于 7.2 元（按实际汇率调整）
CODATA_TOKEN_CNY=0.001
CODATA_USD_CNY=7.2

# 平台能力/接口/价格配置
CODATA_PLATFORMS_FILE=config/platforms.json

# 可选：请求超时（秒）
DATAFLOW_TIMEOUT=30

# 可选：网络错误/服务器繁忙时的最大重试次数
DATAFLOW_RETRY=3

# 可选：两次请求之间的间隔（秒），避免触发风控
DATAFLOW_DELAY=0.6

# 可选：达人资料缓存天数（天内不重复消耗用户信息接口）
DATAFLOW_CACHE_DAYS=30

# 可选：所有服务商统一的超时/重试/请求间隔（不设置则使用 DATAFLOW_* 的值）
CODATA_PROVIDER_TIMEOUT=30
CODATA_PROVIDER_RETRY=3
CODATA_PROVIDER_DELAY=0.6

# 服务商请求是否继承 HTTP_PROXY/HTTPS_PROXY（默认 false，避免代理截获 API Key）
CODATA_PROVIDER_TRUST_ENV=false

# 可选：数据输出目录（相对项目根目录）
DATA_OUTPUT_DIR=data

# 公网部署：允许访问的域名/IP（逗号分隔）
CODATA_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# 前端 Origin（逗号分隔，使用实际访问域名）。本机使用 localhost 访问时也要保留 localhost。
CODATA_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://[::1]:8501
# 可选：线索自动匹配（只匹配本地已采集达人，不产生 API 费用）
CODATA_LEAD_MATCH=true

# 公网 HTTPS 部署时设为 true；本机 HTTP 调试设为 false
CODATA_COOKIE_SECURE=false

# 会话有效期（天）
CODATA_SESSION_DAYS=7

# 是否开放 FastAPI /docs；公网建议 false
CODATA_ENABLE_DOCS=false

# 登录失败限流
CODATA_MAX_LOGIN_ATTEMPTS=10
CODATA_LOGIN_WINDOW_MINUTES=15

# 同时运行的采集任务上限
CODATA_MAX_ACTIVE_JOBS=2

# 超过该分钟数没有心跳的任务会被自动标记失败
CODATA_JOB_STALE_MINUTES=30

# 仅信任来自这些代理的 X-Forwarded-For（公网 Nginx 同机部署保持 127.0.0.1）
CODATA_TRUSTED_PROXIES=127.0.0.1,::1

# 单个请求体上限（字节）
CODATA_MAX_REQUEST_BYTES=5000000

# 审计日志保留天数；运行日志保留天数
CODATA_AUDIT_RETENTION_DAYS=365
CODATA_LOG_RETENTION_DAYS=90

# 数据库备份保留天数和最多份数；0 表示对应规则不限制
CODATA_BACKUP_RETENTION_DAYS=90
CODATA_BACKUP_RETENTION_COUNT=10
